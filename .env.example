# Neon Postgres connection string (Vercel Marketplace -> Neon, or neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/joyride?sslmode=require

# Long random string used by the admin API (x-admin-secret header). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string

# CORS origin allowed to call the API from a browser. "*" for all, or your site URL.
ALLOWED_ORIGIN=https://joyride.promotezz.cc

# Session lifetime (hours) and HWID-reset cooldown (days)
SESSION_HOURS=12
HWID_RESET_COOLDOWN_DAYS=7

# Reported by /api/v1/init
AUTH_VERSION=1.0
